{
  "manifest_version": 3,
  "name": "Фокус-пруд: блокировка сайтов",
  "version": "0.3.0",
  "description": "Закрывает отвлекающие сайты, пока в программе «Фокус-пруд» идёт учебная сессия. Работает только с вашим компьютером, в интернет ничего не отправляет.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": { "gecko": { "id": "focus-pond@carpo.local", "strict_min_version": "128.0" } },
  "permissions": ["webNavigation", "tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Фокус-пруд", "default_icon": { "48": "icons/icon48.png" } }
}
